<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        xmlns:extra="clr-namespace:GetMediaInfoGUI.Controls"
        x:Class="GetMediaInfoGUI.MainWindow"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Title="GetMediaInfo GUI"
        Height="584" 
        Width="522"
        MinWidth="522" 
        MinHeight="584"        
        Icon="../Resources/icon.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Style="{DynamicResource WindowStyle}">
    <!-- Resources -->
    <Window.Resources>
        <ControlTemplate x:Key="closeButton" TargetType="{x:Type Button}">
            <Path Data="M0,0 L8,8 M8,0 L0,8" Margin="5,5,0,0" StrokeThickness="3">
                <Path.Style>
                    <Style TargetType="{x:Type Path}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Stroke" Value="LightGray" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Stroke" Value="Red" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </ControlTemplate>
    </Window.Resources>
    <!-- Body -->
    <Grid x:FieldModifier="private" x:Name="GeneralGrid" Margin="0">
        <!-- Menu -->
        <DockPanel>
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="_Open files…" Click="MenuItemOpenFiles_Click" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="_Open folder…" Click="MenuItemOpenFolder_Click" InputGestureText="Ctrl+Shift+O"/>
                    <MenuItem Header="_Open recent" x:Name="HistoryMenuItem" InputGestureText="Ctrl+H"/>
                    <MenuItem Header="_Close all" Click="MenuItemCloseFiles_Click" InputGestureText="Ctrl+X"/>
                    <Separator />
                    <MenuItem Header="_Exit" Click="MenuItemExit_Click" InputGestureText="Ctrl+E"/>
                </MenuItem>
                <MenuItem Header="_Selection">
                    <MenuItem Header="_Export standard report" Click="MenuItemSaveStandardReport_Click" InputGestureText="Ctrl+S"/>
                    <MenuItem Header="_Export complete report" Click="MenuItemSaveCompleteReport_Click" InputGestureText="Ctrl+Shift+S"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="_Settings" Click="MenuItemSettings_Click"/>
                    <MenuItem Header="_Updater" Click="MenuItemUpdater_Click" />
                </MenuItem>
                <MenuItem Header="_About" Click="MenuItemAbout_Click"/>
            </Menu>
        </DockPanel>
        <!-- TabControl -->
        <TabControl x:Name="FileTabControl" Margin="7.5,20,7.5,40" ItemsSource="{Binding FileTab}">
            <!-- Tab Header -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <extra:AnimatedImage GifSource="/GetMediaInfoGUI;component/Resources/loading.gif" Visibility="{Binding LoadingIconVisibility}"/>
                        <TextBlock Text="{Binding HeaderText}" Margin="0,0,10,0" HorizontalAlignment="Stretch" TextWrapping="Wrap"/>
                        <Button Click="TabItem_CloseButton_Click" Template="{StaticResource ResourceKey=closeButton}" HorizontalAlignment="Right"/>

                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                    <EventSetter Event="Drop" Handler="TabItem_Drop"/>
                    <EventSetter Event="MouseMove" Handler="TabItem_MouseMove"/>
                    <EventSetter Event="MouseDown" Handler="TabItem_MouseDown"/>
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown"/>
                </Style>
            </TabControl.Resources>
            <!-- Tab Body -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TabControl Margin="7.5" VerticalContentAlignment="Stretch" SelectedIndex="{Binding SelectedTabIndex}" SelectedItem="{Binding SelectedTab}" SelectionChanged="TabControl_SelectionChanged">
                        <TabControl.Resources>
                            <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                                <EventSetter Event="Drop" Handler="TabItem_Drop"/>
                                <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove"/>
                            </Style>
                        </TabControl.Resources>
                        <!-- Simple Report -->
                        <TabItem Header="Simple" Visibility="{Binding SimpleReportVisibility}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="General Info" HorizontalContentAlignment="Stretch" Grid.Row="0" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportGeneralSectionVisibility}">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="{Binding SimpleReportCoverWidth}"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Grid.Column="0" Text="{Binding SimpleReportGeneralSection}"
                                                           FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                           FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                                <Image RenderOptions.BitmapScalingMode="Fant" RenderTransformOrigin="2,0" Width="150" Grid.Column="1" Source="{Binding SimpleReportCover}">
                                                    <Image.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Save" Click="MenuItemSaveCover_Click"/>
                                                        </ContextMenu>
                                                    </Image.ContextMenu>
                                                </Image>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="Video Tracks" Grid.Row="1" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportVideoSectionVisibility}">
                                        <TextBlock  TextWrapping="Wrap" Text="{Binding SimpleReportVideoSection}" Margin="0,0,-2,0"
                                                    FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                    FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                    </GroupBox>
                                    <GroupBox  Header="Audio Tracks" Grid.Row="2" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportAudioSectionVisibility}">
                                        <TextBlock  TextWrapping="Wrap" Text="{Binding SimpleReportAudioSection}" Margin="0,0,-2,0"
                                                    FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                    FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                    </GroupBox>
                                    <GroupBox Header="Text Tracks" Grid.Row="3" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportTextSectionVisibility}">
                                        <TextBlock  TextWrapping="Wrap" Text="{Binding SimpleReportTextSection}" Margin="0,0,-2,0"
                                                    FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                    FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                    </GroupBox>
                                    <GroupBox Header="Menu Tracks" Grid.Row="4" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportMenuSectionVisibility}">
                                        <TextBlock  TextWrapping="Wrap" Text="{Binding SimpleReportMenuSection}" Margin="0,0,-2,0"
                                                    FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                    FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                    </GroupBox>
                                    <GroupBox Header="Image Tracks" Grid.Row="5" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2" Visibility="{Binding SimpleReportImageSectionVisibility}">
                                        <TextBlock  TextWrapping="Wrap" Text="{Binding SimpleReportImageSection}" Margin="0,0,-2,0"
                                                    FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}"
                                                    FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" />
                                    </GroupBox>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Standard Report -->
                        <TabItem Header="Standard"  Visibility="{Binding StandardReportVisibility}">
                            <Grid>
                                <TextBox Margin="5" TextWrapping="Wrap" Text="{Binding StandardReport}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                         FontSize="{Binding FontSize}"  FontFamily="{Binding FontFamily}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                                         FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}">
                                    <!--AllowDrop="True"-->
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="Copy" />
                                            <MenuItem Header="Copy All" Click="MenuItemCopyAll_Click"/>
                                            <Separator />
                                            <MenuItem Header="Save" Click="MenuItemSaveStandardReport_Click" InputGestureText="Ctrl+S" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </Grid>
                        </TabItem>
                        <!-- Complete Report -->
                        <TabItem Header="Complete" Visibility="{Binding CompleteReportVisibility}">
                            <Grid>
                                <TextBox Margin="5" TextWrapping="Wrap" Text="{Binding CompleteReport}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                                         FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                                         FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}">
                                    <!--AllowDrop="True"-->
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="Copy" />
                                            <MenuItem Header="Copy All" Click="MenuItemCopyAll_Click"/>
                                            <Separator />
                                            <MenuItem Header="Save" Click="MenuItemSaveCompleteReport_Click" InputGestureText="Ctrl+Shift+S" />
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </Grid>
                        </TabItem>
                        <!-- Tree Report -->
                        <TabItem Header="Tree" Visibility="{Binding TreeReportVisibility}">
                            <TreeView ItemsSource="{Binding TreeReport}" Margin="5">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:TreeViewItem}" ItemsSource="{Binding Path=Children}">
                                        <TreeViewItem Header="{Binding Header}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </TabItem>
                    </TabControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <!-- Status Bar -->
        <StatusBar Height="35" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Stretch">
            <Label x:FieldModifier="private" x:Name="StatusLab" Content="" Height="35" />
        </StatusBar>
    </Grid>
</Window>
