<Window x:Class="GetMediaInfoGUI.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Components Updater" 
        Topmost="True" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" 
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Width="394" 
        Height="170"
        Icon="../Resources/icon.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Style="{DynamicResource WindowStyle}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label x:FieldModifier="private" x:Name="simpleStatus" Grid.Row="0" Content="Step 0 of 3" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        
        <ProgressBar x:FieldModifier="private" x:Name="ProgressUpdate" Grid.Row="1" VerticalAlignment="Center" Height="28" Margin="5,2"/>
        <Label x:FieldModifier="private" x:Name="ProgressLabel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Idle"/>
        
        <Button x:FieldModifier="private" x:Name="CancelButton" Grid.Row="2" Content="Cancel" Click="CancelButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,2"/>

        <Expander x:FieldModifier="private" x:Name="Expander" Grid.Row="3" Header="More details" VerticalAlignment="Stretch" Margin="4,0" IsExpanded="False" Collapsed="Expander_Collapsed" Expanded="Expander_Expanded">
            <TextBox x:FieldModifier="private" x:Name="Log" TextWrapping="Wrap" IsReadOnly="True" ScrollViewer.CanContentScroll="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,4"/>
        </Expander>
    </Grid>
</Window>

