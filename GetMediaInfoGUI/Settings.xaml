<Window x:Class="GetMediaInfoGUI.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Loaded="Window_Loaded" ResizeMode="NoResize" Title="Settings" Height="569.028" Width="485"
        Icon="icon.ico" WindowStartupLocation="CenterOwner">
    <FrameworkElement.Resources>
        <CollectionViewSource x:Key="myFonts" Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
            <CollectionViewSource.SortDescriptions>
                <ComponentModel:SortDescription PropertyName="Source"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <Style x:Key="FontStyle">
            <Setter Property="Control.FontFamily" Value="{Binding Source}"/>
            <Setter Property="Control.FontSize" Value="16"/>
        </Style>
        <DataTemplate x:Key="FontTemplate">
            <StackPanel VirtualizingStackPanel.IsVirtualizing="true">
                <TextBlock Style="{StaticResource FontStyle}" Text="{Binding Source}" ToolTip="{Binding Source}"/>
            </StackPanel>
        </DataTemplate>
    </FrameworkElement.Resources>
    <Grid Margin="0,0,0,1">
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="GetMediaInfo Version:" VerticalAlignment="Top"
               Height="17" Width="132" Margin="11,8,0,0"/>
        <TextBlock x:Name="StatusGetMediaInfo" x:FieldModifier="private" TextWrapping="Wrap" Text=""
               VerticalAlignment="Top" Height="17" FontWeight="Bold" Margin="148,8,10,0"/>
        <TextBlock HorizontalAlignment="Left" Margin="11,30,0,0" TextWrapping="Wrap" Text="MediaInfo Version:"
               VerticalAlignment="Top" Height="17" Width="132"/>
        <TextBlock x:Name="StatusMediaInfo" x:FieldModifier="private" TextWrapping="Wrap" Text=""
               VerticalAlignment="Top" Height="17" Margin="148,30,10,0" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="GUI Version:" VerticalAlignment="Top"
               Height="18" Width="132" Margin="10,52,0,0"/>
        <TextBlock x:Name="StatusGUI" x:FieldModifier="private" TextWrapping="Wrap" Text="" VerticalAlignment="Top"
               Height="18" FontWeight="Bold" Margin="148,52,10,0"/>
        <GroupBox x:Name="UpdaterMediaInfo" x:FieldModifier="private" Header="Updates" Margin="10,75,10,401"
              HorizontalContentAlignment="Stretch">
            <Grid Margin="0,2,0,-2">
                <Button Click="UpdateButton_Click" x:Name="UpdateButton" x:FieldModifier="private"
                Content="Check for updates" HorizontalAlignment="Left" VerticalAlignment="Top" Width="106"
                Height="27" Margin="10,5,0,0"/>
                <Label x:Name="UpdaterProgress" x:FieldModifier="private" Margin="121,5,10,0" VerticalAlignment="Top"
               RenderTransformOrigin="0.241,-0.546" Height="27"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="GeneralSetting" x:FieldModifier="private" Header="General" Margin="10,141,10,208"
              HorizontalContentAlignment="Stretch">
            <StackPanel Margin="10,10,10,4">
                <CheckBox Checked="AutoSaveReport_CheckedUnchecked" Unchecked="AutoSaveReport_CheckedUnchecked"
                  x:Name="AutoSaveReport" x:FieldModifier="private" Content="Auto save standard report to disk"
                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <CheckBox Checked="DisableSimple_CheckedUnchecked" Unchecked="DisableSimple_CheckedUnchecked"
                  x:Name="DisableSimple" x:FieldModifier="private" Content="Disable simple report"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7.5,0,0"/>
                <CheckBox Checked="DisableComplete_CheckedUnchecked" Unchecked="DisableComplete_CheckedUnchecked"
                  x:Name="DisableComplete" x:FieldModifier="private" Content="Disable complete report"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7.5,0,0"/>
                <CheckBox Checked="DisableTree_CheckedUnchecked" Unchecked="DisableTree_CheckedUnchecked"
                  x:Name="DisableTree" x:FieldModifier="private" Content="Disable tree report"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7.5,0,0"/>
                <CheckBox Checked="EnableMilliseconds_CheckedUnchecked" Unchecked="EnableMilliseconds_CheckedUnchecked"
                  x:Name="EnableMilliseconds" x:FieldModifier="private"
                  Content="Show milliseconds in tracks duration" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="0,7.5,0,0"/>
                <CheckBox Checked="RemoveSpace_CheckedUnchecked" Unchecked="RemoveSpace_CheckedUnchecked"
                  x:Name="RemoveSpace" x:FieldModifier="private"
                  Content="Remove justification from standard and complete reports" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="0,7.5,0,0"/>
                <CheckBox Checked="ShowCover_CheckedUnchecked" Unchecked="ShowCover_CheckedUnchecked" x:Name="ShowCover"
                  x:FieldModifier="private" Content="Show cover if present" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="0,7.5,0,0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox x:Name="TextSettings" x:FieldModifier="private" Header="Appearance" Margin="10,329,10,0"
              Height="64" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Left" Height="41" Margin="0,0,-2,-4" VerticalAlignment="Top" Width="449">
                <ComboBox SelectionChanged="ComboBoxSize_SelectionChanged" x:Name="ComboBoxFontSize"
                  x:FieldModifier="private" HorizontalAlignment="Left" Margin="196,7,0,0" VerticalAlignment="Top"
                  Width="133" Height="27" UseLayoutRounding="true" FontSize="16" SelectedItem="">
                    <ItemsControl.ItemsSource>
                        <x:Array Type="{x:Type System:Double}">
                            <System:Double>10</System:Double>
                            <System:Double>11</System:Double>
                            <System:Double>12</System:Double>
                            <System:Double>14</System:Double>
                            <System:Double>16</System:Double>
                            <System:Double>18</System:Double>
                            <System:Double>21</System:Double>
                            <System:Double>24</System:Double>
                            <System:Double>27</System:Double>
                        </x:Array>
                    </ItemsControl.ItemsSource>
                </ComboBox>
                <Button Click="BoldControl_Click" x:Name="BoldControl" x:FieldModifier="private" Content="B"
                HorizontalAlignment="Left" Margin="334,7,0,0" VerticalAlignment="Top" Width="25" Height="27"
                FontSize="16" FontWeight="Bold" Background="{x:Null}" BorderBrush="{x:Null}"/>
                <Button Click="ItalicControl_Click" x:Name="ItalicControl" x:FieldModifier="private" Content="I"
                HorizontalAlignment="Left" Margin="364,7,0,0" VerticalAlignment="Top" Width="25" Height="27"
                FontSize="16" FontStyle="Italic" Background="{x:Null}" BorderBrush="{x:Null}"/>
                <ComboBox SelectionChanged="ComboBoxFont_SelectionChanged" x:Name="ComboBoxFontFamily"
                  x:FieldModifier="private" ItemTemplate="{DynamicResource FontTemplate}" HorizontalAlignment="Left"
                  VerticalAlignment="Top" Margin="11,7,0,0" Height="27" Width="180"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="true"
                  ItemsSource="{Binding Source={StaticResource myFonts}}">

                </ComboBox>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="AssociationOptions" x:FieldModifier="private" Header="Context menu" Margin="10,398,10,75"
              HorizontalContentAlignment="Stretch">
            <Grid>
                <Button Click="AddContextMenu_Click" x:Name="AddContextMenu" x:FieldModifier="private" Content="Create"
                HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Height="27" Margin="10,8,0,0"/>
                <Button Click="RemoveContextMenu_Click" x:Name="RemoveContextMenu" x:FieldModifier="private"
                Content="Remove" HorizontalAlignment="Left" Margin="90,8,0,0" Width="75" VerticalAlignment="Top"
                VerticalContentAlignment="Center" Height="27"/>
                <Label x:Name="AssociationStatus" x:FieldModifier="private" Margin="170,8,10,0" VerticalAlignment="Top"
               RenderTransformOrigin="0.241,-0.546" Height="27"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="RecentFilesOptions" x:FieldModifier="private" Header="Recent files history"
              HorizontalAlignment="Stretch" Margin="10,467,10,6">
            <Grid>
                <WindowsFormsHost FrameworkElement.Height="23" FrameworkElement.Margin="88,11,284,0"
                          FrameworkElement.VerticalAlignment="Top">
                    <WindowsFormsHost.Child>
                        <wf:NumericUpDown ValueChanged="HistorySize_ValueChanged" x:Name="HistorySize" Maximum="20" Minimum="0"/>
                    </WindowsFormsHost.Child>
                </WindowsFormsHost>
                <Button Click="ClearRecentFileList_Click" x:Name="ClearRecentFileList" x:FieldModifier="private"
                VerticalAlignment="Top" Margin="0,9,10,0" Content="Clear history" HorizontalAlignment="Right"
                Height="27" Width="119"/>
                <Label Content="History size:" Margin="10,9,364,0" VerticalAlignment="Top" Height="27"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>