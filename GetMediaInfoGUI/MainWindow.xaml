<Window x:Class="GetMediaInfoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        Drop="Windows_Drop" DragEnter="Windows_DragEnter" Loaded="Window_Loaded" Closing="Windows_Closing"
        KeyDown="Window_KeyDown" AllowDrop="true" Title="GetMediaInfo" Height="584" Width="522"
        MinWidth="522" MinHeight="584" Icon="../icon.ico">
    <FrameworkElement.Resources>
        <ControlTemplate x:Key="closeButton" TargetType="{x:Type Button}">
            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8 " Margin="5,5,0,0" StrokeThickness="3">
                <FrameworkElement.Style>
                    <Style TargetType="{x:Type Path}">
                        <Style.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="false">
                                <Setter Property="Shape.Stroke" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="true">
                                <Setter Property="Shape.Stroke" Value="Red"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </FrameworkElement.Style>
            </Path>
        </ControlTemplate>
    </FrameworkElement.Resources>
    <Grid x:Name="GeneralGrid" x:FieldModifier="private" Margin="0">
        <DockPanel>
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Click="MenuItemOpenFiles_Click" Header="_Open file/s" InputGestureText="Ctrl+O"/>
                    <MenuItem Click="MenuItemOpenFolder_Click" Header="_Open folder" InputGestureText="Ctrl+Shift+O"/>
                    <MenuItem Click="MenuItemSaveStandardReport_Click" Header="_Export standard report" InputGestureText="Ctrl+S"/>
                    <MenuItem Click="MenuItemSaveCompleteReport_Click" Header="_Export complete report"
                    InputGestureText="Ctrl+Shift+S"/>
                    <MenuItem Click="MenuItemCloseFiles_Click" Header="_Close all files" InputGestureText="Ctrl+X"/>
                    <Separator/>
                    <MenuItem x:Name="HistoryMenuItem" x:FieldModifier="private" Header="_Recent files" InputGestureText="Ctrl+H"/>
                    <Separator/>
                    <MenuItem Click="MenuItemExit_Click" Header="_Exit" InputGestureText="Ctrl+E"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Click="MenuItemSettings_Click" Header="_Settings"/>
                    <MenuItem Click="MenuItemUpdater_Click" Header="_Updater"/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <TabControl MouseDown="FileTabControl_MouseDown" x:Name="FileTabControl" x:FieldModifier="private" SelectionChanged="TabControl_SelectionChanged"
                Margin="7.5,20,7.5,40" ItemsSource="{Binding FileTab}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <local:GifImage GifSource="/GetMediaInfoGUI;component/Resources/loading.gif"
                            Visibility="{Binding LoadingIconVisibility}"/>
                        <TextBlock Margin="0,0,10,0" HorizontalAlignment="Stretch" TextWrapping="Wrap" Text="{Binding HeaderText}"/>
                        <Button Template="{StaticResource closeButton}" HorizontalAlignment="Right" Click="CloseTabButton_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TabControl Margin="7.5" VerticalContentAlignment="Stretch" SelectedIndex="{Binding SelectedTabIndex}"
                      SelectedItem="{Binding SelectedTab}">
                        <FrameworkElement.Resources>
                            <Style TargetType="{x:Type TabItem}">
                                <Setter Property="UIElement.AllowDrop" Value="true"/>
                            </Style>
                        </FrameworkElement.Resources>
                        <TabItem Header="Simple" Visibility="{Binding SimpleReportVisibility}" PreviewMouseMove="TabItem_PreviewMouseMove" Drop="TabItem_Drop">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <GroupBox Header="General Info" HorizontalContentAlignment="Stretch" Grid.Row="0" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportGeneralSectionVisibility}">
                                        <Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="{Binding SimpleReportCoverWidth}"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Grid.Column="0" Text="{Binding SimpleReportGeneralSection}"/>
                                                <Image RenderOptions.BitmapScalingMode="Fant" RenderTransformOrigin="2,0" Width="150" Grid.Column="1"
                               Source="{Binding SimpleReportCover}">
                                                    <FrameworkElement.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Save" Click="MenuItemSaveCover_Click"/>
                                                        </ContextMenu>
                                                    </FrameworkElement.ContextMenu>
                                                </Image>
                                            </Grid>
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Header="Video Tracks" Grid.Row="1" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportVideoSectionVisibility}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Text="{Binding SimpleReportVideoSection}"/>
                                    </GroupBox>
                                    <GroupBox Header="Audio Tracks" Grid.Row="2" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportAudioSectionVisibility}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Text="{Binding SimpleReportAudioSection}"/>
                                    </GroupBox>
                                    <GroupBox Header="Text Tracks" Grid.Row="3" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportTextSectionVisibility}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Text="{Binding SimpleReportTextSection}"/>
                                    </GroupBox>
                                    <GroupBox Header="Menu Tracks" Grid.Row="4" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportMenuSectionVisibility}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Text="{Binding SimpleReportMenuSection}"/>
                                    </GroupBox>
                                    <GroupBox Header="Image Tracks" Grid.Row="5" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2"
                            Visibility="{Binding SimpleReportImageSectionVisibility}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,-2,0" Text="{Binding SimpleReportImageSection}"/>
                                    </GroupBox>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Standard" Visibility="{Binding StandardReportVisibility}" PreviewMouseMove="TabItem_PreviewMouseMove" Drop="TabItem_Drop">
                            <Grid>
                                <TextBox Margin="5" TextWrapping="Wrap" IsReadOnly="true" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" AllowDrop="true"
                         Text="{Binding StandardReport}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}"
                         FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" PreviewDragOver="TextBoxReport_PreviewDragOver">
                                    <FrameworkElement.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="Copy"/>
                                            <MenuItem Header="Copy All" Click="CopyAll_Click" />
                                            <Separator/>
                                            <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="MenuItemSaveStandardReport_Click"/>
                                        </ContextMenu>
                                    </FrameworkElement.ContextMenu>
                                </TextBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Complete" Visibility="{Binding CompleteReportVisibility}" PreviewMouseMove="TabItem_PreviewMouseMove" Drop="TabItem_Drop">
                            <Grid>
                                <TextBox Margin="5" TextWrapping="Wrap" IsReadOnly="true" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" AllowDrop="true"
                         Text="{Binding CompleteReport}" FontSize="{Binding FontSize}" FontFamily="{Binding FontFamily}"
                         FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}" PreviewDragOver="TextBoxReport_PreviewDragOver">
                                    <FrameworkElement.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="Copy"/>
                                            <MenuItem Header="Copy All" Click="CopyAll_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Save" InputGestureText="Ctrl+Shift+S" Click="MenuItemSaveCompleteReport_Click"/>
                                        </ContextMenu>
                                    </FrameworkElement.ContextMenu>
                                </TextBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Tree" Visibility="{Binding TreeReportVisibility}" PreviewMouseMove="TabItem_PreviewMouseMove" Drop="TabItem_Drop">
                            <TreeView Margin="5" ItemsSource="{Binding TreeReport}">
                                <ItemsControl.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type local:TreeViewItem}" ItemsSource="{Binding Path=Children}">
                                        <TreeViewItem HorizontalAlignment="Left" VerticalAlignment="Top" Header="{Binding Header}"/>
                                    </HierarchicalDataTemplate>
                                </ItemsControl.ItemTemplate>
                            </TreeView>
                        </TabItem>
                    </TabControl>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <StatusBar Height="35" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom"
               HorizontalContentAlignment="Stretch">
            <Label x:Name="StatusLab" x:FieldModifier="private" Content="" Height="35"/>
        </StatusBar>
    </Grid>
</Window>