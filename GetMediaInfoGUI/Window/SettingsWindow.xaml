<Window
    x:Class="GetMediaInfoGUI.Window.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:System="clr-namespace:System;assembly=System.Runtime"
    xmlns:ctx="clr-namespace:GetMediaInfoGUI.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Advanced Settings"
    Width="480"
    Height="580"
    Icon="../Resource/icon.ico"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    Style="{DynamicResource WindowStyle}"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="60" />
            <RowDefinition Height="170" />
            <RowDefinition Height="90" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!--  Version information  -->
        <GroupBox
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="Information">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <!--  Frontend Version  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="Frontend Version:"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatusFrontend"
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text=""
                    TextWrapping="Wrap" />
                <!--  MediaInfo Version  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="MediaInfo Version:"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatusMediaInfo"
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text=""
                    TextWrapping="Wrap" />
                <!--  GetMediaInfo Version  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="GetMediaInfo Version:"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatusGetMediaInfo"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text=""
                    TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!--  Updater section  -->
        <GroupBox
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="Updates">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CheckUpdatesButton"
                    Grid.Column="0"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="CheckUpdatesButton_Click"
                    Content="Check for updates" />
                <TextBlock
                    x:Name="CheckUpdatesProgress"
                    Grid.Column="1"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TextAlignment="Center" />
            </Grid>
        </GroupBox>

        <!--  General settings  -->
        <GroupBox
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="General">
            <Grid Margin="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <CheckBox
                    x:Name="AutoSaveReport"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="AutoSaveReport_CheckedUnchecked"
                    Content="Auto save standard report to disk"
                    Unchecked="AutoSaveReport_CheckedUnchecked" />
                <CheckBox
                    x:Name="DisableSimple"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="DisableSimple_CheckedUnchecked"
                    Content="Disable simple report"
                    Unchecked="DisableSimple_CheckedUnchecked" />
                <CheckBox
                    x:Name="DisableComplete"
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="DisableComplete_CheckedUnchecked"
                    Content="Disable complete report"
                    Unchecked="DisableComplete_CheckedUnchecked" />
                <CheckBox
                    x:Name="DisableTree"
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="DisableTree_CheckedUnchecked"
                    Content="Disable tree report"
                    Unchecked="DisableTree_CheckedUnchecked" />
                <CheckBox
                    x:Name="EnableMilliseconds"
                    Grid.Row="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="EnableMilliseconds_CheckedUnchecked"
                    Content="Show milliseconds in tracks duration"
                    Unchecked="EnableMilliseconds_CheckedUnchecked" />
                <CheckBox
                    x:Name="RemoveSpace"
                    Grid.Row="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="RemoveSpace_CheckedUnchecked"
                    Content="Remove justification from reports"
                    Unchecked="RemoveSpace_CheckedUnchecked" />
                <CheckBox
                    x:Name="ShowCover"
                    Grid.Row="6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Checked="ShowCover_CheckedUnchecked"
                    Content="Show cover if present"
                    Unchecked="ShowCover_CheckedUnchecked" />
            </Grid>
        </GroupBox>

        <!--  Appearence settings  -->
        <GroupBox
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="Appearance">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Theme:"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="ThemeSelector"
                        Grid.Column="1"
                        Margin="4"
                        SelectedValuePath="Content"
                        SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBoxItem IsSelected="True">Auto</ComboBoxItem>
                        <ComboBoxItem>Light</ComboBoxItem>
                        <ComboBoxItem>Dark</ComboBoxItem>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="Report:"
                        TextWrapping="Wrap" />

                    <ComboBox
                        x:Name="ComboBoxFontFamily"
                        Grid.Column="1"
                        Margin="4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ItemTemplate="{DynamicResource FontTemplate}"
                        SelectionChanged="ComboBoxFont_SelectionChanged">
                        <ComboBox.Resources>
                            <CollectionViewSource x:Key="myFonts" Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
                                <CollectionViewSource.SortDescriptions>
                                    <ComponentModel:SortDescription PropertyName="Source" />
                                </CollectionViewSource.SortDescriptions>
                            </CollectionViewSource>
                            <Style x:Key="FontStyle">
                                <Setter Property="Control.FontFamily" Value="{Binding Source}" />
                            </Style>
                            <DataTemplate x:Key="FontTemplate">
                                <StackPanel VirtualizingStackPanel.IsVirtualizing="True">
                                    <TextBlock
                                        Style="{StaticResource FontStyle}"
                                        Text="{Binding Source}"
                                        ToolTip="{Binding Source}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.Resources>
                        <ComboBox.ItemsSource>
                            <Binding Source="{StaticResource myFonts}" />
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <ComboBox
                        x:Name="ComboBoxFontSize"
                        Grid.Column="2"
                        Margin="4,4,10,4"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        SelectedItem="2"
                        SelectionChanged="ComboBoxSize_SelectionChanged">
                        <ComboBox.ItemsSource>
                            <x:Array Type="{x:Type System:Double}">
                                <System:Double>10</System:Double>
                                <System:Double>11</System:Double>
                                <System:Double>12</System:Double>
                                <System:Double>14</System:Double>
                                <System:Double>16</System:Double>
                                <System:Double>18</System:Double>
                                <System:Double>21</System:Double>
                                <System:Double>24</System:Double>
                                <System:Double>27</System:Double>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>

                    <CheckBox
                        x:Name="BoldControl"
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="BoldControl_Click"
                        Content="Bold"
                        FontSize="14"
                        FontWeight="Bold" />
                    <CheckBox
                        x:Name="ItalicControl"
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="ItalicControl_Click"
                        Content="Italic"
                        FontSize="14"
                        FontStyle="Italic" />
                </Grid>
            </Grid>
        </GroupBox>

        <!--  Context menu settings  -->
        <GroupBox
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="Context menu">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="AddContextMenu"
                    Grid.Column="0"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="AddContextMenu_Click"
                    Content="Create" />
                <Button
                    x:Name="RemoveContextMenu"
                    Grid.Column="1"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="RemoveContextMenu_Click"
                    Content="Remove" />
                <TextBlock
                    x:Name="AssociationStatus"
                    Grid.Column="2"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    TextAlignment="Center" />
            </Grid>
        </GroupBox>

        <!--  History settings  -->
        <GroupBox
            Grid.Row="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Header="Recent files history">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Text="History size:" />
                <ctx:NumericUpDown
                    x:Name="HistorySize"
                    Grid.Column="1"
                    Width="130"
                    Height="22"
                    MaxValue="20"
                    MinValue="0"
                    ShowButtons="True"
                    ValueChanged="HistorySize_ValueChanged" />
                <Button
                    x:Name="ClearRecentFileList"
                    Grid.Column="2"
                    Width="90"
                    Margin="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="ClearRecentFileList_Click"
                    Content="Clear history" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>