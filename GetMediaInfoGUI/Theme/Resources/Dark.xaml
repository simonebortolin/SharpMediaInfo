            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="templateRoot" Value="{StaticResource ControlMouseOverBackground}" Property="Background"/>
                <Setter TargetName="templateRoot" Value="{StaticResource ControlMouseOverBackground}" Property="BorderBrush"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
