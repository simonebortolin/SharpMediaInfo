                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Border BorderBrush="{StaticResource ControlDefaultBorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{StaticResource ControlDefaultBackground}" CornerRadius="1">
                            <Border BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1">
