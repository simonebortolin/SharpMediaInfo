<Window x:Class="GetMediaInfoGUI.Theme.Custom.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI.Theme.Custom"
        mc:Ignorable="d"
        MinHeight="130"
        MaxHeight="350"
        MinWidth="250"
        MaxWidth="400"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Style="{DynamicResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <!-- Message dialog content -->
        <TextBlock x:Name="MessageContent"          
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   TextWrapping="WrapWithOverflow"
                   TextTrimming="None"
                   Margin="10"/>

        <!-- Darken buttons panel background -->
        <StatusBar Grid.Row="1">
            <!-- Buttons panel -->
            <StatusBarItem DockPanel.Dock="Right" Padding="0">
                <Button x:Name="CancelButton" 
                        x:FieldModifier="private"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="5,0"
                        Width="80"
                        Tag="1"
                        Content="Cancel"
                        Click="Button_Click"/>
            </StatusBarItem>
            
            <StatusBarItem DockPanel.Dock="Right" Padding="0">
                <Button x:Name="NoButton"  
                        x:FieldModifier="private"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="5,0"
                        Width="80"
                        Content="No"
                        Tag="3"
                        Click="Button_Click"/>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right" Padding="0">
                <Button x:Name="OkButton"  
                        x:FieldModifier="private"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="5,0"
                        Width="80"
                        Content="Ok"
                        Tag="0"
                        Click="Button_Click"/>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right" Padding="0">
                <Button x:Name="YesButton"  
                        x:FieldModifier="private"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="5,0"
                        Width="80"
                        Content="Yes"
                        Tag="2"
                        Click="Button_Click"/>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right"><!-- Do not remove --></StatusBarItem>

        </StatusBar>
    </Grid>
</Window>
