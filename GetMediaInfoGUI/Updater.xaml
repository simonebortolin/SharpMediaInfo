<Window x:Class="GetMediaInfoGUI.Updater"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Closing="Window_Closing" Title="Components Updater" Topmost="true"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Width="394" Height="170"
        VerticalContentAlignment="Bottom" Icon="icon.ico">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition x:Name="ExpanderGrid" x:FieldModifier="private" Height="51"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Click="CancelButton_Click" x:Name="CancelButton" x:FieldModifier="private" Content="Cancel"
            Margin="0,4,0,0" HorizontalContentAlignment="Center" HorizontalAlignment="Center"
            VerticalContentAlignment="Center" Width="60" Padding="0" Grid.Row="1" VerticalAlignment="Top"
            Height="23" Panel.ZIndex="10"/>
        <ProgressBar x:Name="ProgressUpdate" x:FieldModifier="private" RenderTransformOrigin="0.063,-4.233"
                 Margin="10,46,10,16" VerticalAlignment="Center" Height="28"/>
        <Label x:Name="ProgressLabel" x:FieldModifier="private" HorizontalContentAlignment="Center"
           Margin="10,42,10,18" VerticalAlignment="Center" Height="30" Content="Idle" Padding="0,3,0,0"
           VerticalContentAlignment="Center"/>
        <Expander Collapsed="Expander_Collapsed" Expanded="Expander_Expanded" x:Name="Expander"
              x:FieldModifier="private" Header="Details" Margin="10,4,10,0" VerticalAlignment="Top" Grid.Row="1"
              Height="23" IsExpanded="true">
            <TextBox x:Name="Log" x:FieldModifier="private" TextWrapping="Wrap" IsReadOnly="true"
               ScrollViewer.CanContentScroll="true" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0"/>
        </Expander>
        <Label x:Name="simpleStatus" x:FieldModifier="private" Content="Step 0 of 3" HorizontalAlignment="Left"
           Margin="10,11,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>