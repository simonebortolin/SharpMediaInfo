<Project>
  <Import Project="BuildVersion.props" />

  <PropertyGroup>
    <!-- Central shared versions -->
    <MediaInfoVersion>26.10</MediaInfoVersion>
    <LibZenVersion>0.4.41</LibZenVersion>
    <!-- Single source of truth for the .NET target framework used across the solution.
         Projects compose it (e.g. $(DotNetTfm)-windows); the source generator stays on
         netstandard2.0 as Roslyn requires. -->
    <DotNetTfm>net10.0</DotNetTfm>
  </PropertyGroup>

  <!-- Assembly metadata shared by every project (PE file properties, NuGet packages). -->
  <PropertyGroup>
    <Authors>Simone Bortolin</Authors>
    <Company>Simone Bortolin</Company>
    <Product>SharpMediaInfo</Product>
    <Copyright>Copyright (c) Simone Bortolin</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/simonebortolin/SharpMediaInfo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simonebortolin/SharpMediaInfo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Keep the product version clean ("26.10.0"), without the "+<commit sha>" SourceLink suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Pack the repository README and LICENSE alongside every NuGet package. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')" />
  </ItemGroup>

  <!-- Optional: common UsingTask for reading file version (can be used by any project) -->
  <UsingTask TaskName="GetFileVersionTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <Version Output="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        try
        {
          var info = System.Diagnostics.FileVersionInfo.GetVersionInfo(FilePath);
          Version = info.FileVersion ?? info.ProductVersion ?? "0.0.0";
          return true;
        }
        catch
        {
          Version = "0.0.0";
          return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>
</Project>
