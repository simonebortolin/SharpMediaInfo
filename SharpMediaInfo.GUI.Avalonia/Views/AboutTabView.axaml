<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SharpMediaInfo.GUI.ViewModels;assembly=SharpMediaInfo.GUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SharpMediaInfo.GUI.Avalonia.Views.AboutTabView"
             x:DataType="vm:AboutTabViewModel">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="20,16">
            
            <!-- App Icon and Name -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="12">
                <Border Width="96" Height="96" 
                        CornerRadius="16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="📹" 
                               FontSize="48" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock Text="{Binding AppName}" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding AppVersion}" 
                           FontSize="16"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Text="{Binding Description}" 
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Margin="0,8,0,0"/>

            <Separator Margin="0,16"/>

            <!-- Version Information -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Version Information" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Application Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding AppVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="MediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding MediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="SharpMediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding SharpMediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                </Grid>
            </StackPanel>

            <Separator Margin="0,16"/>

            <!-- Links -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Links" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="🔗 Project Repository" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding GitHubUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                    
                    <Button Content="ℹ️ MediaInfo Website" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding MediaInfoUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,16"/>

            <!-- Credits -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Credits" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <TextBlock TextWrapping="Wrap" FontSize="14">
                    <Run Text="Made with &#x2764; and:" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="&#x2022; MediaInfo - Unified display of technical and tag data"/>
                    <LineBreak/>
                    <Run Text="&#x2022; Avalonia UI with Fluent Design"/>
                    <LineBreak/>
                    <Run Text="&#x2022; CommunityToolkit.Mvvm"/>
                    <LineBreak/>
                    <Run Text="&#x2022; .NET 8"/>
                </TextBlock>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Text="{Binding Copyright}"  
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Margin="0,24,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
