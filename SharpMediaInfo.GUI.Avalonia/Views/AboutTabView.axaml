<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SharpMediaInfo.GUI.ViewModels;assembly=SharpMediaInfo.GUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SharpMediaInfo.GUI.Avalonia.Views.AboutTabView"
             x:Name="Root"
             x:DataType="vm:AboutTabViewModel">
    <!-- Borderless, flush-left button so library rows read as hyperlinks rather than UI actions. -->
    <UserControl.Styles>
        <Style Selector="Button.Link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.Link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>
    </UserControl.Styles>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="20,16">
            
            <!-- App Icon and Name -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="12">
                <Border Width="96" Height="96" 
                        CornerRadius="16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="📹" 
                               FontSize="48" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock Text="{Binding AppName}" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding AppVersion}" 
                           FontSize="16"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Text="{Binding Description}" 
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Margin="0,8,0,0"/>

            <Separator Margin="0,16"/>

            <!-- Version Information -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Version Information" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Application Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding AppVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="MediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding MediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="SharpMediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding SharpMediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                </Grid>
            </StackPanel>

            <Separator Margin="0,16"/>

            <!-- Links -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Links" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="🔗 Project Repository" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding GitHubUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                    
                    <Button Content="ℹ️ MediaInfo Website" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding MediaInfoUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                </StackPanel>
            </StackPanel>

            <Separator Margin="0,16"/>

            <!-- Credits: one clickable row per used library (see AboutTabViewModel.Libraries) -->
            <StackPanel Spacing="8" Margin="12">
                <TextBlock Text="Used libraries"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <ItemsControl ItemsSource="{Binding Libraries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AboutLinkItem">
                            <StackPanel Margin="0,0,0,8">
                                <Button Classes="Link" Content="{Binding Name}" FontWeight="SemiBold"
                                        Command="{Binding #Root.((vm:AboutTabViewModel)DataContext).OpenUrlCommand}"
                                        CommandParameter="{Binding Url}"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Made with &#x2764;&#xFE0F; (and a lot of media files)"
                       HorizontalAlignment="Center"
                       Opacity="0.75"
                       FontSize="12"
                       Margin="0,16,0,0"/>

            <!-- Copyright -->
            <TextBlock Text="{Binding Copyright}"  
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Margin="0,8,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
