<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>$(DotNetTfm);$(DotNetTfm)-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>SharpMediaInfo (Avalonia)</AssemblyTitle>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia Core -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />

    <!-- Avalonia developer tools (F12, Debug only) -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    
    <!-- MessageBox for Avalonia -->
    <PackageReference Include="MessageBox.Avalonia" Version="12.1.0" />
    
    <!-- MVVM & DI -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    
    <!-- Retry Logic -->
    <PackageReference Include="Polly" Version="8.6.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared ViewModels & Logic -->
    <ProjectReference Include="..\SharpMediaInfo.GUI\SharpMediaInfo.GUI.csproj" />
    
    <!-- Core Library -->
    <ProjectReference Include="..\SharpMediaInfo\SharpMediaInfo.csproj" />

    <!-- Avalonia Cascadia Theme (git submodule; brings Avalonia.Themes.Fluent along) -->
    <ProjectReference Include="..\extern\CascadiaUI\src\CascadiaUI\CascadiaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\FileTabView.axaml.cs">
      <DependentUpon>FileTabView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\SettingTabView.axaml.cs">
      <DependentUpon>SettingTabView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Behaviors\" />
  </ItemGroup>
</Project>
