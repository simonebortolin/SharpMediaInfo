<Window x:Class="GetMediaInfoGUI.UpdateDLL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        mc:Ignorable="d"
        Title="Update Component" 
        Icon="icon.ico" 
        Topmost="True" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" 
        Width="322" Height="181">
    <Grid Margin="0">
        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="125,125,125,6"/>
        <ProgressBar x:Name="ProgressUpdate" RenderTransformOrigin="0.063,-4.233" Margin="10,101,10,31"/>
        <TextBox x:Name="Log" TextWrapping="Wrap" IsReadOnly="True" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto" Margin="10,10,10,55"/>
    </Grid>
</Window>

