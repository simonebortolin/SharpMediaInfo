<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase" x:Class="GetMediaInfoGUI.MainWindow"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="Windows_Drop"
        DragEnter="Windows_DragEnter"
        Loaded="Window_Loaded"
        Closing="Windows_Closing"
        Title="GetMediaInfo" 
        Height="584" 
        Width="522" 
        MinWidth="522" 
        MinHeight="584" 
        Icon="icon.ico">
    <Grid x:Name="GeneralGrid" x:FieldModifier="private" Margin="0">
        <TextBox x:Name="FilePathBox" x:FieldModifier="private" Height="23" Margin="9,10,174,0" Text="" TextWrapping="NoWrap" VerticalAlignment="Top" Drop="Windows_Drop" DragEnter="Windows_DragEnter" Grid.ColumnSpan="3" TextChanged="FilePathBox_TextChanged" AllowDrop="True" VerticalContentAlignment="Center" />
        <Button x:Name="OpenFile" x:FieldModifier="private" Content="Open File" HorizontalAlignment="Right" Margin="0,10,93,0" VerticalAlignment="Top" Width="75" Height="23" Click="OpenFile_Click" Drop="Windows_Drop" DragEnter="Windows_DragEnter" />
        <Button x:Name="SaveReport" x:FieldModifier="private" Content="Save Report" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.184,-0.277" Height="23" Click="SaveReport_Click" Drop="Windows_Drop" DragEnter="Windows_DragEnter" />
        <TabControl x:Name="Pages" x:FieldModifier="private" Margin="10,38,10,35" VerticalContentAlignment="Stretch" Drop="Windows_Drop" DragEnter="Windows_DragEnter" >
            <TabItem Header="Simple">
                <Grid x:Name="Grid" x:FieldModifier="private">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox x:Name="GeneralInfo" x:FieldModifier="private" Header="General Infos" HorizontalContentAlignment="Stretch" Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid x:Name="GeneralInfoColl" x:FieldModifier="private">
                            <Grid x:Name="GeneralInfoGrid" x:FieldModifier="private">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="150" x:Name="CoverGrid" x:FieldModifier="private"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="GeneralInfoText" x:FieldModifier="private" TextWrapping="Wrap" Margin="0,0,-2,0" Grid.Column="0"/>
                                <Image x:Name="cover" x:FieldModifier="private" RenderOptions.BitmapScalingMode="Fant" RenderTransformOrigin="2,0" Width="150" Grid.Column="1">
                                    <Image.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="SaveCover" x:FieldModifier="private" Header="Save" Click="SaveCover_Click"/>
                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>
                            </Grid>


                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="TVideo" x:FieldModifier="private" Header="Video Tracks" Grid.Row="1" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="VideoInfoText" x:FieldModifier="private" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>
                    <GroupBox x:Name="TAudio" x:FieldModifier="private" Header="Audio Tracks" Grid.Row="2" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="AudioInfoText" x:FieldModifier="private" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>
                    <GroupBox x:Name="TText" x:FieldModifier="private" Header="Text Tracks" Grid.Row="3" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="TextInfoText" x:FieldModifier="private" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>

                </Grid>
            </TabItem>
            <TabItem Header="Standard">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxStandard" x:FieldModifier="private" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="{Binding Path=FontSize}"  FontFamily="{Binding ElementName=ComboBoxFont, Path=SelectedItem}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" AllowDrop="True"
                             Drop="Windows_Drop" DragEnter="Windows_DragEnter" PreviewDragOver="TextBoxReport_PreviewDragOver">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="Copy" />
                                <MenuItem x:Name="CopyAll_Standard" x:FieldModifier="private" Header="Copy All" Click="CopyAll_Click" IsEnabled="False"/>
                                <Separator />
                                <MenuItem x:Name="SaveReport_Standard" x:FieldModifier="private" Header="Save" Click="SaveReport_Click" IsEnabled="False" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </TabItem>
            <TabItem Header="Complete">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxComplete" x:FieldModifier="private" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="{Binding Path=FontSize}" FontFamily="{Binding ElementName=ComboBoxFont, Path=SelectedItem}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" AllowDrop="True"
                             Drop="Windows_Drop" DragEnter="Windows_DragEnter" PreviewDragOver="TextBoxReport_PreviewDragOver">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="Copy" />
                                <MenuItem x:Name="CopyAll_Complete" x:FieldModifier="private" Header="Copy All" Click="CopyAll_Click" IsEnabled="False"/>
                                <Separator />
                                <MenuItem x:Name="SaveReport_Complete" x:FieldModifier="private" Header="Save" Click="SaveReport_Click" IsEnabled="False" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </TabItem>
            <TabItem Header="Tree">
                <TreeView x:FieldModifier="private" x:Name="TreeReport"/>
            </TabItem>
            <TabItem Header="Options">
                <Grid Background="#FFE5E5E5">
                    <GroupBox x:Name="AssociationOptions" x:FieldModifier="private" Header="Association Options" Margin="10,305,10,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Height="64">
                        <Grid>
                            <Button x:Name="AddContextMenu" x:FieldModifier="private" Content="Associate" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="AddContextMenu_Click" Height="27" Margin="10,8,0,0"/>
                            <Button x:Name="RemoveContextMenu" x:FieldModifier="private" Content="Remove" HorizontalAlignment="Left" Margin="90,8,0,0" Width="75" VerticalAlignment="Top" VerticalContentAlignment="Center" Click="RemoveContextMenu_Click" Height="27"/>
                            <Label x:Name="AssociationStatus" x:FieldModifier="private" Content="Ready." Margin="170,9,10,0" VerticalAlignment="Top" RenderTransformOrigin="0.241,-0.546" Height="26"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="GeneralSetting" x:FieldModifier="private" Header="General Settings" Margin="10,54,10,0" VerticalAlignment="Top" Height="131" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <CheckBox x:Name="AutoSaveReport" x:FieldModifier="private" Content="Auto save Standard Report to disk" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Checked="AutoSaveReport_CheckedUnchecked"  Unchecked="AutoSaveReport_CheckedUnchecked"/>
                            <CheckBox x:Name="DisableSimpleInfo" x:FieldModifier="private" Content="Disable Simple Report" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top" Checked="DisableSimpleInfo_Checked" Unchecked="DisableSimpleInfo_Unchecked"/>
                            <CheckBox x:Name="EnableMilliSecond" x:FieldModifier="private" Content="Add milliseconds in tracks duration" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Checked="EnableMilliSecond_CheckedUnchecked" Unchecked="EnableMilliSecond_CheckedUnchecked"/>
                            <CheckBox x:Name="DisableTree" x:FieldModifier="private" Content="Disable Tree View" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Checked="DisableTreeInfo_Checked" Unchecked="DisableTreeInfo_Unchecked"/>
                            <CheckBox x:Name="RemoveSpace" x:FieldModifier="private" Content="Remove spaces in Standard and Complete Report" HorizontalAlignment="Left" Margin="10,90,0,-5" VerticalAlignment="Top" Checked="RemoveSpace_CheckedUnchecked" Unchecked="RemoveSpace_CheckedUnchecked"/>
                        </Grid>
                    </GroupBox>
                    <Button x:Name="Version" x:FieldModifier="private" Content="Version" HorizontalAlignment="Right" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Right" Width="86" Click="Version_Click"/>
                    <TextBlock x:Name="textGetMediaInfos" x:FieldModifier="private" HorizontalAlignment="Left" TextWrapping="Wrap" Text="GetMediainfos Version:" VerticalAlignment="Top" Height="17" Width="154" Margin="10,10,0,0"/>
                    <TextBlock x:Name="StatusGetMediaInfos" x:FieldModifier="private" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="17" Width="99" FontWeight="Bold" Margin="147,10,0,0"/>
                    <TextBlock x:Name="textMediainfo" x:FieldModifier="private" HorizontalAlignment="Left" Margin="10,32,0,0" TextWrapping="Wrap" Text="Mediainfo Version:" VerticalAlignment="Top" Height="17" Width="154"/>
                    <TextBlock x:Name="StatusMediainfo" x:FieldModifier="private" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="17" Width="99" Margin="147,32,0,0" FontWeight="Bold"/>
                    <GroupBox x:Name="UpdaterBox" x:FieldModifier="private" Header="Updater Options&#xD;&#xA;" Margin="10,244,10,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Height="61">
                        <Grid Margin="0,-12,0,-2">
                            <Button x:Name="UpdateButton" x:FieldModifier="private" Content="Run Updater" HorizontalAlignment="Left" VerticalAlignment="Top" Width="106" Click="UpdateButton_Click" Height="27" Margin="10,5,0,0"/>
                            <Label x:Name="UpdaterProgress" x:FieldModifier="private" Content="Ready." Margin="121,6,10,0" VerticalAlignment="Top" RenderTransformOrigin="0.241,-0.546" Height="26"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="TextSettings" x:FieldModifier="private" Header="Text Settings" Margin="10,185,10,0" Height="59" VerticalAlignment="Top">
                        <Grid HorizontalAlignment="Left" Height="41" Margin="0,0,0,0" VerticalAlignment="Top" Width="459">
                            <ComboBox x:Name="ComboBoxSize" x:FieldModifier="private" HorizontalAlignment="Left" Margin="196,7,0,0" VerticalAlignment="Top" Width="133" Height="27" UseLayoutRounding="True" FontSize="16" SelectedItem="" SelectionChanged="ComboBoxSize_SelectionChanged">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type System:Double}">
                                        <System:Double>10</System:Double>
                                        <System:Double>11</System:Double>
                                        <System:Double>12</System:Double>
                                        <System:Double>14</System:Double>
                                        <System:Double>16</System:Double>
                                        <System:Double>18</System:Double>
                                        <System:Double>21</System:Double>
                                        <System:Double>24</System:Double>
                                        <System:Double>27</System:Double>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <Button x:Name="BoldControl" x:FieldModifier="private" Content="B" HorizontalAlignment="Left" Margin="334,7,0,0" VerticalAlignment="Top" Width="25" Height="27" Click="BoldControl_Click" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" FontWeight="Bold"/>
                            <Button x:Name="ItalicControl" x:FieldModifier="private" Content="I" HorizontalAlignment="Left" Margin="364,7,0,0" VerticalAlignment="Top" Width="25" Height="27" Click="ItalicControl_Click" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" FontStyle="Italic"/>
                            <ComboBox x:Name="ComboBoxFont" x:FieldModifier="private" 
                        		ItemTemplate="{DynamicResource FontTemplate}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="11,7,0,0" Height="27" Width="180" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="True" SelectionChanged="ComboBoxFont_SelectionChanged">
                                <ComboBox.Resources>

                                    <CollectionViewSource x:Key="myFonts" Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
                                        <CollectionViewSource.SortDescriptions>
                                            <ComponentModel:SortDescription PropertyName="Source" />
                                        </CollectionViewSource.SortDescriptions>
                                    </CollectionViewSource>

                                    <Style x:Key="FontStyle">
                                        <Setter Property="Control.FontFamily" Value="{Binding Source}" />
                                        <Setter Property="Control.FontSize" Value="16" />
                                    </Style>

                                    <DataTemplate x:Key="FontTemplate">
                                        <StackPanel VirtualizingStackPanel.IsVirtualizing="True">
                                            <TextBlock Style="{StaticResource FontStyle}"
                        						Text="{Binding Source}"
                        						ToolTip="{Binding Source}" />
                                        </StackPanel>
                                    </DataTemplate>

                                </ComboBox.Resources>

                                <ComboBox.ItemsSource>
                                    <Binding Source="{StaticResource myFonts}" />
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>
                    </GroupBox>

                </Grid>
            </TabItem>

        </TabControl>
        <StatusBar Height="35" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Stretch">
            <Label x:Name="StatusLab" x:FieldModifier="private" Content="" Height="35" />
        </StatusBar>

    </Grid>
</Window>
