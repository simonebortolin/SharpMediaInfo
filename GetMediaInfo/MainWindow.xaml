<Window x:Class="GetMediaInfoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="OpenDroppedFile"
        DragEnter="DragEnter_EventHandler"
        Loaded="Inizialize"
        Closing="SaveAndClose"
        Title="GetMediaInfo" Height="470.821" Width="591.125" MinWidth="419" MinHeight="456">
    <Grid Margin="0,0,2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="filepathBox" Height="23" Margin="9,10,174,0" Text="" TextWrapping="NoWrap" VerticalAlignment="Top" Grid.ColumnSpan="3" TextChanged="AnalyzeDeclaredPath" />
        <StatusBar Height="25" Margin="0,330,10,0" VerticalAlignment="Top" VerticalContentAlignment="Bottom" Grid.ColumnSpan="3"/>
        <Button x:Name="OpenFile" Content="Open File" HorizontalAlignment="Right" Margin="0,10,93,0" VerticalAlignment="Top" Width="75" Height="23" Click="OpenFile_Click"/>
        <Button x:Name="SaveReport" Content="Save Report" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.184,-0.277" Height="23" Click="SaveReport_Click"/>
        <TabControl x:Name="tabControl" Margin="10,38,10,35" VerticalContentAlignment="Stretch">
            <TabItem Header="Simple">
                <Grid Background="#FFE5E5E5" Name="Grid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="188*"/>
                        <ColumnDefinition Width="367*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="33*" />
                        <RowDefinition Height="27*" />
                        <RowDefinition Height="22*" />
                        <RowDefinition Height="22*" />
                    </Grid.RowDefinitions>
                    <GroupBox x:Name="GeneralInfo" Header="General Infos" HorizontalContentAlignment="Stretch" Grid.Row="0" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="GeneralInfoText" TextWrapping="Wrap" Text="" Margin="0,0,-2,0" IsManipulationEnabled="True"/>
                    </GroupBox>
                    <GroupBox x:Name="TVideo" Header="Video Tracks" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="video_info" TextWrapping="Wrap" Text="" Margin="0,0,-2,0" IsManipulationEnabled="True"/>
                    </GroupBox>
                    <GroupBox x:Name="TAudio" Header="Audio Tracks" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="audio_info" TextWrapping="Wrap" Text="" Margin="0,0,-2,0" IsManipulationEnabled="True"/>
                    </GroupBox>
                    <GroupBox x:Name="TSub" Header="Subtitles" Grid.Row="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="sub_info" TextWrapping="Wrap" Text="" Margin="0,0,-2,0" IsManipulationEnabled="True"/>
                    </GroupBox>

                </Grid>
            </TabItem>
            <TabItem Header="Standard">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxStandard" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            
            <TabItem Header="Complete">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxComplete" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </TabItem>
            <TabItem Header="Tree (Beta)">
                <TreeView Name="TreeReport">
                </TreeView>
            </TabItem>
            <TabItem Header="Options">
                <Grid Background="#FFE5E5E5">
                    <GroupBox x:Name="groupBox" Header="ContextMenu Options" Margin="10,106,10,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Button x:Name="AddContextMenu" Content="Add" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="AddContextMenu_Click" Height="27"/>
                            <Button x:Name="RemoveContextMenu" Content="Remove" HorizontalAlignment="Left" Margin="80,0,0,0" Width="75" VerticalAlignment="Top" VerticalContentAlignment="Center" Click="RemoveContextMenu_Click" Height="27"/>
                            <Label x:Name="AssociationStatus" Content="" Margin="165,0,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.241,-0.546" Height="26"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="groupBox1" Header="Setting" Margin="10,176,10,0" VerticalAlignment="Top" Height="134" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <CheckBox x:Name="AutoSaveReport" Content="Auto Save Report to Disk" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Checked="AutoSaveReport_Checked"  Unchecked="AutoSaveReport_Unchecked"/>
                            <CheckBox x:Name="DisableSimpleInfo" Content="Disable Simple Info" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top" Checked="DisableSimpleInfo_Checked" Unchecked="DisableSimpleInfo_Unchecked"/>
                            <CheckBox x:Name="MilliSec" Content="Activate milliseconds" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Checked="MS_Change" Unchecked="MS_Change"/>
                            <CheckBox x:Name="DisableTree" Content="Disable Tree Info" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Checked="DisableTreeInfo_Checked" Unchecked="DisableTreeInfo_Unchecked" IsChecked="True"/>
                            <CheckBox x:Name="RemoveSpace" Content="Remove Space in The Standard e Complete Report" HorizontalAlignment="Left" Margin="10,90,0,-5" VerticalAlignment="Top" Checked="RemoveSpace_Reload" Unchecked="RemoveSpace_Reload"/>
                            <Button x:Name="font" Content="Font" HorizontalAlignment="Left" Margin="423,10,0,0" VerticalAlignment="Top" Width="75" Click="font_Click"/>
                        </Grid>
                    </GroupBox>
                    <Label x:Name="Version" Content="Version" HorizontalAlignment="Right" Margin="0,0,46,10" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Right"/>
                    <Grid HorizontalAlignment="Left" Height="74" Margin="10,10,0,0" VerticalAlignment="Top" Width="253">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14*"/>
                            <ColumnDefinition Width="9*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Status GetMediaInfos.dll" VerticalAlignment="Top" Height="37" Width="154"/>
                        <TextBlock x:Name="StatusGetMediaInfos" Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="37" Width="99" FontWeight="Bold"/>
                        <TextBlock x:Name="textBlock2" HorizontalAlignment="Left" Margin="0,37,0,0" TextWrapping="Wrap" Text="Status MediaInfo.dll" VerticalAlignment="Top" Height="37" Width="154"/>
                        <TextBlock x:Name="StatusMediainfo" Grid.Column="1" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="37" Width="99" Margin="0,37,0,0" FontWeight="Bold"/>
                    </Grid>

                </Grid>
            </TabItem>
        </TabControl>
        <StatusBar Height="35" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Stretch">
            <Label x:Name="toolStripStatusLabel1" Content="" Width="173" Height="35" />
        </StatusBar>

    </Grid>
</Window>
