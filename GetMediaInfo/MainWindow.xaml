<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetMediaInfoGUI"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase" x:Class="GetMediaInfoGUI.MainWindow"
        mc:Ignorable="d"
        AllowDrop="True"
        Drop="OpenDroppedFile_Event"
        DragEnter="DragEnter_EventHandler"
        Loaded="Inizialize_Loaded"
        Closing="SaveAndClose_Event"
        Icon="icon.ico"
        Title="GetMediaInfo" 
        Height="584.836" 
        Width="522.918" 
        MinWidth="522" 
        MinHeight="584">
    <Grid Margin="0,0,2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="filepathBox" Height="23" Margin="9,10,174,0" Text="" TextWrapping="NoWrap" VerticalAlignment="Top" Drop="OpenDroppedFile_Event" DragEnter="DragEnter_EventHandler" Grid.ColumnSpan="3" TextChanged="AnalyzeDeclaredPath_Event" AllowDrop="True" />
        <StatusBar Height="25" Margin="0,330,10,0" VerticalAlignment="Top" VerticalContentAlignment="Bottom" Grid.ColumnSpan="3" Drop="OpenDroppedFile_Event" DragEnter="DragEnter_EventHandler" />
        <Button x:Name="OpenFile" Content="Open File" HorizontalAlignment="Right" Margin="0,10,93,0" VerticalAlignment="Top" Width="75" Height="23" Click="OpenFile_Click" Drop="OpenDroppedFile_Event" DragEnter="DragEnter_EventHandler" />
        <Button x:Name="SaveReport" Content="Save Report" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.184,-0.277" Height="23" Click="SaveReport_Click" Drop="OpenDroppedFile_Event" DragEnter="DragEnter_EventHandler" />
        <TabControl x:Name="tabControl" Margin="10,38,10,35" VerticalContentAlignment="Stretch" Drop="OpenDroppedFile_Event" DragEnter="DragEnter_EventHandler" >
            <TabItem Header="Simple">
                <Grid x:Name="Grid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GroupBox x:Name="GeneralInfo" Header="General Infos" HorizontalContentAlignment="Stretch" Grid.Row="0" Grid.ColumnSpan="2">
                        <Grid x:Name="GeneralInfoColl">
                            <Image x:Name="image" />
                            <TextBlock x:Name="GeneralInfoText" TextWrapping="Wrap" Margin="0,0,-2,0"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="TVideo" Header="Video Tracks" Grid.Row="1" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="VideoInfoText" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>
                    <GroupBox x:Name="TAudio" Header="Audio Tracks" Grid.Row="2" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="AudioInfoText" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>
                    <GroupBox x:Name="TSub" Header="Subtitles" Grid.Row="3" HorizontalContentAlignment="Stretch" Grid.ColumnSpan="2">
                        <TextBlock x:Name="SubInfoText" TextWrapping="Wrap" Text="" Margin="0,0,-2,0"/>
                    </GroupBox>

                </Grid>
            </TabItem>
            <TabItem Header="Standard">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxStandard" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="{Binding Path=FontSize}"  FontFamily="{Binding ElementName=ComboBoxFont, Path=SelectedItem}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="Copy" />
                                <MenuItem Header="Copy All" Click="CopyAllText_Click"/>
                                <Separator />
                                <MenuItem x:Name="SaveMenu" Header="Save" Click="SaveReport_Click" IsEnabled="False" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </TabItem>

            <TabItem Header="Complete">
                <Grid Background="#FFE5E5E5">
                    <TextBox x:Name="TextBoxComplete" Margin="5" TextWrapping="Wrap" Text="" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontSize="{Binding Path=FontSize}" FontFamily="{Binding ElementName=ComboBoxFont, Path=SelectedItem}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="Copy" />
                                <MenuItem Header="Copy All" Click="CopyAllText_Click"/>
                                <Separator />
                                <MenuItem x:Name="SaveMenu_1" Header="Save" Click="SaveReport_Click" IsEnabled="False" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </TabItem>
            <TabItem Header="Tree">
                <TreeView x:Name="TreeReport"/>
            </TabItem>
            <TabItem Header="Options">
                <Grid Background="#FFE5E5E5">
                    <GroupBox x:Name="groupBox" Header="ContextMenu Options" Margin="10,284,10,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Height="64">
                        <Grid>
                            <Button x:Name="AddContextMenu" Content="Add" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Click="AddContextMenu_Click" Height="27" Margin="10,8,0,0"/>
                            <Button x:Name="RemoveContextMenu" Content="Remove" HorizontalAlignment="Left" Margin="90,8,0,0" Width="75" VerticalAlignment="Top" VerticalContentAlignment="Center" Click="RemoveContextMenu_Click" Height="27"/>
                            <Label x:Name="AssociationStatus" Content="Ready." Margin="170,9,10,0" VerticalAlignment="Top" RenderTransformOrigin="0.241,-0.546" Height="26"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox x:Name="groupBox1" Header="Setting" Margin="10,54,10,0" VerticalAlignment="Top" Height="167" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <CheckBox x:Name="AutoSaveReport" Content="Auto Save Report to Disk" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Checked="AutoSaveReport_Checked"  Unchecked="AutoSaveReport_Unchecked"/>
                            <CheckBox x:Name="DisableSimpleInfo" Content="Disable Simple Info" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top" Checked="DisableSimpleInfo_Checked" Unchecked="DisableSimpleInfo_Unchecked"/>
                            <CheckBox x:Name="MilliSec" Content="Activate milliseconds" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Checked="MilliSec_Reload" Unchecked="MilliSec_Reload"/>
                            <CheckBox x:Name="DisableTree" Content="Disable Tree Info" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Checked="DisableTreeInfo_Checked" Unchecked="DisableTreeInfo_Unchecked"/>
                            <CheckBox x:Name="RemoveSpace" Content="Remove Space in The Standard e Complete Report" HorizontalAlignment="Left" Margin="10,90,0,-5" VerticalAlignment="Top" Checked="RemoveSpace_Reload" Unchecked="RemoveSpace_Reload"/>
                            <ComboBox x:Name="ComboBoxSize" HorizontalAlignment="Left" Margin="167,110,0,0" VerticalAlignment="Top" Width="91" Height="27" UseLayoutRounding="True" FontSize="16" SelectedItem="" DropDownClosed="Size_Change">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type System:Double}">
                                        <System:Double>10</System:Double>
                                        <System:Double>11</System:Double>
                                        <System:Double>12</System:Double>
                                        <System:Double>14</System:Double>
                                        <System:Double>16</System:Double>
                                        <System:Double>18</System:Double>
                                        <System:Double>21</System:Double>
                                        <System:Double>24</System:Double>
                                        <System:Double>27</System:Double>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                            <Button x:Name="B" Content="B" HorizontalAlignment="Left" Margin="263,110,0,0" VerticalAlignment="Top" Width="25" Height="27" Click="Bold_Click" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" FontWeight="Bold"/>
                            <Button x:Name="I" Content="I" HorizontalAlignment="Left" Margin="293,110,0,0" VerticalAlignment="Top" Width="25" Height="27" Click="Italic_Click" Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" FontStyle="Italic"/>
                            <ComboBox x:Name="ComboBoxFont"
                            	ItemTemplate="{DynamicResource FontTemplate}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,110,0,0" Height="27" Width="151" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="True" DropDownClosed="Font_Change">
                                <ComboBox.Resources>

                                    <CollectionViewSource x:Key="myFonts" Source="{Binding Source={x:Static Fonts.SystemFontFamilies}}">
                                        <CollectionViewSource.SortDescriptions>
                                            <ComponentModel:SortDescription PropertyName="Source" />
                                        </CollectionViewSource.SortDescriptions>
                                    </CollectionViewSource>

                                    <Style x:Key="FontStyle">
                                        <Setter Property="Control.FontFamily" Value="{Binding Source}" />
                                        <Setter Property="Control.FontSize" Value="16" />
                                    </Style>

                                    <DataTemplate x:Key="FontTemplate">
                                        <StackPanel VirtualizingStackPanel.IsVirtualizing="True">
                                            <TextBlock Style="{StaticResource FontStyle}"
                            					Text="{Binding Source}"
                            					ToolTip="{Binding Source}" />
                                        </StackPanel>
                                    </DataTemplate>

                                </ComboBox.Resources>

                                <ComboBox.ItemsSource>
                                    <Binding Source="{StaticResource myFonts}" />
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>
                    </GroupBox>
                    <Button x:Name="Version" Content="Version" HorizontalAlignment="Right" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Right" Width="86" Click="Version_Click"/>
                    <TextBlock x:Name="textBlock" HorizontalAlignment="Left" TextWrapping="Wrap" Text="GetMediainfos Version:" VerticalAlignment="Top" Height="17" Width="154" Margin="10,10,0,0"/>
                    <TextBlock x:Name="StatusGetMediaInfos" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="17" Width="99" FontWeight="Bold" Margin="147,10,0,0"/>
                    <TextBlock x:Name="textBlock2" HorizontalAlignment="Left" Margin="10,32,0,0" TextWrapping="Wrap" Text="Mediainfo Version:" VerticalAlignment="Top" Height="17" Width="154"/>
                    <TextBlock x:Name="StatusMediainfo" HorizontalAlignment="Left" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Height="17" Width="99" Margin="147,32,0,0" FontWeight="Bold"/>
                    <GroupBox x:Name="UpdaterBox" Header="Updates Options" Margin="10,218,10,0" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" Height="61">
                        <Grid>
                            <Button x:Name="UpdateButton" Content="Check for Updates" HorizontalAlignment="Left" VerticalAlignment="Top" Width="106" Click="UpdateButton_Click" Height="27" Margin="10,7,0,0"/>
                            <Label x:Name="UpdaterProgress" Content="Ready." Margin="121,8,10,0" VerticalAlignment="Top" RenderTransformOrigin="0.241,-0.546" Height="26"/>
                        </Grid>
                    </GroupBox>
                    
                </Grid>
            </TabItem>
            
        </TabControl>
        <StatusBar Height="35" VerticalAlignment="Bottom" VerticalContentAlignment="Bottom" HorizontalContentAlignment="Stretch">
            <Label x:Name="toolStripStatusLabel1" Content="" Width="173" Height="35" />
        </StatusBar>

    </Grid>
</Window>
