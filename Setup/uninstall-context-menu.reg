Windows Registry Editor Version 5.00

; SharpMediaInfo Context Menu Uninstaller
; Double-click to remove context menu entries
; NOTE: Removes from HKEY_CURRENT_USER (current user only)

; Remove from all files
[-HKEY_CURRENT_USER\Software\Classes\*\shell\SharpMediaInfo]

; Remove from folders
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\SharpMediaInfo]
