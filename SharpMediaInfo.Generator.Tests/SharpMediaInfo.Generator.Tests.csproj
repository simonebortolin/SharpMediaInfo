<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(DotNetTfm)</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Source\*.csv">

			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Source\*.json">

			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <AdditionalFiles Include="Source\Audio.csv" />
	  <AdditionalFiles Include="Source\AudioOverride.json" />
	  <AdditionalFiles Include="Source\General.csv" />
	  <AdditionalFiles Include="Source\GeneralOverride.json" />
	  <AdditionalFiles Include="Source\Image.csv" />
	  <AdditionalFiles Include="Source\InternalTest.csv" />
	  <AdditionalFiles Include="Source\InternalTestOverride.json" />
	  <AdditionalFiles Include="Source\Menu.csv" />
	  <AdditionalFiles Include="Source\MenuOverride.json" />
	  <AdditionalFiles Include="Source\Other.csv" />
	  <AdditionalFiles Include="Source\Text.csv" />
	  <AdditionalFiles Include="Source\TextOverride.json" />
	  <AdditionalFiles Include="Source\Video.csv" />
	  <AdditionalFiles Include="Source\VideoOverride.json" />
      <AdditionalFiles Include="Source\InternalTest.csv" />
	  <AdditionalFiles Include="Source\InternalTestOverride.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="TUnit" Version="1.5.80" />
		<PackageReference Include="Verify.SourceGenerators" Version="2.5.0" />
		<PackageReference Include="Verify.TUnit" Version="31.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpMediaInfo.Generator\SharpMediaInfo.Generator.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
	</ItemGroup>

</Project>
