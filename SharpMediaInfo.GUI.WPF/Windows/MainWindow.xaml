<Window x:Class="SharpMediaInfo.GUI.WPF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SharpMediaInfo.GUI.WPF.Converters"
        xmlns:controls="clr-namespace:SharpMediaInfo.GUI.WPF.Controls"
        xmlns:views="clr-namespace:SharpMediaInfo.GUI.WPF.Views"
        xmlns:vm="clr-namespace:SharpMediaInfo.GUI.ViewModels;assembly=SharpMediaInfo.GUI"
        mc:Ignorable="d"
        Title="SharpMediaInfo GUI" 
        Height="600" 
        Width="900"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">
    
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
        <Window.InputBindings>
        <KeyBinding Key="S"
                Modifiers="Control"
                Command="{Binding SaveStandardReportCommand}" />
        <KeyBinding Key="S"
                Modifiers="Control+Shift"
                Command="{Binding SaveCompleteReportCommand}" />
        <KeyBinding Key="O"
                Modifiers="Control"
                Command="{Binding OpenFilesCommand}" />
        <KeyBinding Key="O"
                Modifiers="Control+Shift"
                Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="X"
                Modifiers="Control"
                Command="{Binding CloseAllFilesCommand}" />

    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding" Value="2,-2,2,-2"/>
                    <Setter Property="MinHeight" Value="15"/>
                </Style>
            </Menu.ItemContainerStyle>
            <MenuItem Header="_File" >
                <MenuItem Header="Open _Multiple Files" Command="{Binding OpenFilesCommand}" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Open F_older" Command="{Binding OpenFolderCommand}" InputGestureText="Ctrl+Shift+O"/>
                <MenuItem Header="_Close All Files" Command="{Binding CloseAllFilesCommand}" InputGestureText="Ctrl+X"/>
                <MenuItem Header="Open Recent"
          ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command"
                    Value="{Binding DataContext.OpenRecentFileCommand,
                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click" InputGestureText="Ctrl+X"/>
            </MenuItem>
            <MenuItem Header="_Selection">
                <MenuItem Header="Save _Standard Report" Command="{Binding SaveStandardReportCommand}" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _Complete Report" Command="{Binding SaveCompleteReportCommand}" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="Save C_over" Command="{Binding SaveCoverCommand}"/>
            </MenuItem>
            <MenuItem Header="_Tools"  >
                <MenuItem Header="_Setting" Command="{Binding OpenSettingCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help"  >
                <MenuItem Header="_About" Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <TabControl Grid.Row="1" 
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Margin="5"
                    x:Name="MainTabControl"
                    AllowDrop="True"
                    Drop="TabControl_Drop">
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type vm:FileTabViewModel}">
                    <views:FileTabView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                    <views:SettingsTabView />
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:AboutTabViewModel}">
                    <views:AboutTabView />
                </DataTemplate>
            </TabControl.Resources>
            
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_PreviewMouseLeftButtonDown"/>
                    <EventSetter Event="PreviewMouseMove" Handler="TabItem_PreviewMouseMove"/>
                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TabItem_PreviewMouseLeftButtonUp"/>
                    <EventSetter Event="Drop" Handler="TabItem_Drop"/>
                    <Setter Property="AllowDrop" Value="True"/>
                </Style>
            </TabControl.ItemContainerStyle>
            
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>
                        <Button Content="✕" 
                                Width="16" 
                                Height="16"
                                FontSize="10"
                                Padding="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" 
                                CommandParameter="{Binding}"
                                ToolTip="Close">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
