<UserControl x:Class="SharpMediaInfo.GUI.WPF.Views.FileTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SharpMediaInfo.GUI.WPF.Views"
        xmlns:converters="clr-namespace:SharpMediaInfo.GUI.WPF.Converters"
        xmlns:controls="clr-namespace:SharpMediaInfo.GUI.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <!-- Loading indicator -->
        <Grid Visibility="{Binding Model.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   FontSize="16"/>
        </Grid>

        <!-- Content when ready -->
        <TabControl Visibility="{Binding Model.IsReady, Converter={StaticResource BoolToVisibilityConverter}}">
            <!-- Simple Report -->
            <TabItem Header="Simple Report" Visibility="{Binding Configuration.DisableSimpleReport, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=!}">
                <controls:SimpleReportViewer Sections="{Binding SimpleReportSections}" 
                                            Configuration="{Binding Configuration}"
                                            CoverData="{Binding Model.CoverData}"
                                            HasCover="{Binding Model.HasCover}"
                                            SaveCoverCommand="{Binding DataContext.SaveCoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </TabItem>

            <!-- Standard Report -->
            <TabItem Header="Standard Report">
                <TextBox Text="{Binding Model.StandardReport, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{Binding Configuration.ReportFontFamily}"
                     FontSize="{Binding Configuration.ReportFontSize}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Configuration.ReportBoldStyle}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Configuration.ReportItalicStyle}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="Copy All" Command="{Binding CopyAllStandardCommand}" />
                            <Separator/>
                            <MenuItem Header="Save" Command="{Binding SaveStandardCommand}" InputGestureText="Ctrl+S"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </TabItem>

            <!-- Complete Report -->
            <TabItem Header="Complete Report" Visibility="{Binding Configuration.DisableCompleteReport, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=!}">
                <TextBox Text="{Binding Model.CompleteReport, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="{Binding Configuration.ReportFontFamily}"
                     FontSize="{Binding Configuration.ReportFontSize}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Configuration.ReportBoldStyle}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Configuration.ReportItalicStyle}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="Copy All" Command="{Binding CopyAllCompleteCommand}"/>
                            <Separator/>
                            <MenuItem Header="Save" Command="{Binding SaveCompleteCommand}" InputGestureText="Ctrl+Shift+S"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </TabItem>

            <!-- Tree Report -->
            <TabItem Header="Tree Report" Visibility="{Binding Configuration.DisableTreeReport, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=!}">
                <controls:TreeReportViewer Nodes="{Binding TreeReportNodes}"
                                          Configuration="{Binding Configuration}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
