<UserControl
    x:Class="SharpMediaInfo.GUI.WPF.Views.AboutTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d" 
    d:DesignHeight="600" d:DesignWidth="800">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center">
            
            <!-- App Icon and Name -->
            <StackPanel HorizontalAlignment="Center" Margin="12">
                <!-- Icon Placeholder (aggiungi un'icona se disponibile) -->
                <Border Width="96" Height="96" 
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        CornerRadius="16"
                        HorizontalAlignment="Center">
                    <TextBlock Text="📹" 
                               FontSize="48" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>
                
                <TextBlock Text="{Binding AppName}" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding AppVersion}" 
                           FontSize="16" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Text="{Binding Description}" 
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,0"/>

            <Separator/>

            <!-- Version Information -->
            <StackPanel Margin="12">
                <TextBlock Text="Version Information" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Application Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding AppVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="MediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" 
                               Text="{Binding MediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="SharpMediaInfo Version" 
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" 
                               Text="{Binding SharpMediaInfoVersion}" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,8"/>
                </Grid>
            </StackPanel>

            <Separator/>

            <!-- Links -->
            <StackPanel Margin="12">
                <TextBlock Text="Links" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔗 Project Repository" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding GitHubUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                    
                    <Button Content="ℹ️ MediaInfo Website" 
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding MediaInfoUrl}"
                            Padding="16,8"
                            MinWidth="180"/>
                </StackPanel>
            </StackPanel>

            <Separator/>

            <!-- Credits -->
            <StackPanel Margin="12">
                <TextBlock Text="Credits" 
                           FontSize="20" 
                           FontWeight="SemiBold"/>
                
                <TextBlock TextWrapping="Wrap" FontSize="14">
                    <Run Text="Made with &#x2764; and:" FontWeight="SemiBold"/>
                    <LineBreak/>
                    <Run Text="&#x2022; MediaInfo - Unified display of technical and tag data"/>
                    <LineBreak/>
                    <Run Text="&#x2022; WPF with Fluent Design"/>
                    <LineBreak/>
                    <Run Text="&#x2022; CommunityToolkit.Mvvm"/>
                    <LineBreak/>
                    <Run Text="&#x2022; .NET 10"/>
                </TextBlock>
            </StackPanel>

            <!-- Copyright -->
            <TextBlock Text="{Binding Copyright}"  
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       Margin="0,24,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
