<UserControl
    x:Class="SharpMediaInfo.GUI.WPF.Views.SettingsTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ComponentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:views="clr-namespace:SharpMediaInfo.GUI.WPF.Views" 
    xmlns:models="clr-namespace:SharpMediaInfo.GUI.Models;assembly=SharpMediaInfo.GUI"
    xmlns:converters="clr-namespace:SharpMediaInfo.GUI.WPF.Converters"
    xmlns:ctx="clr-namespace:SharpMediaInfo.GUI.WPF.Controls">
    <UserControl.Resources>
        <CollectionViewSource x:Key="FontFamilies" Source="{x:Static Fonts.SystemFontFamilies}">
            <CollectionViewSource.SortDescriptions>
                <ComponentModel:SortDescription PropertyName="Source" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <DataTemplate x:Key="FontTemplate">
            <TextBlock FontFamily="{Binding Source}" Text="{Binding Source}" ToolTip="{Binding Source}" />
        </DataTemplate>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            
            <!-- Information Expander -->
            <Expander IsExpanded="True" Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="Information" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Padding="8,12" />
                </Expander.Header>
                <Border Padding="16,8,16,16" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SharpMediaInfo GUI Version:" Margin="0,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Margin="0,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MediaInfo Version:" Margin="0,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MediaInfoVersion}" Margin="0,8" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SharpMediaInfo Version:" Margin="0,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SharpMediaInfoVersion}" Margin="0,8" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Expander>
            
            <!-- General Expander -->
            <Expander IsExpanded="True" Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="General" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Padding="8,12" />
                </Expander.Header>
                <Border Padding="16,8,16,16" >
                    <StackPanel>
                        <CheckBox Content="Auto save standard report to disk" 
                                  IsChecked="{Binding Configuration.AutoSaveReport}"
                                  Margin="0,6" />
                        <CheckBox Content="Disable simple report" 
                                  IsChecked="{Binding Configuration.DisableSimpleReport}"
                                  Margin="0,6" />
                        <CheckBox Content="Disable complete report" 
                                  IsChecked="{Binding Configuration.DisableCompleteReport}"
                                  Margin="0,6" />
                        <CheckBox Content="Disable tree report" 
                                  IsChecked="{Binding Configuration.DisableTreeReport}"
                                  Margin="0,6" />
                        <CheckBox Content="Show milliseconds in tracks duration" 
                                  IsChecked="{Binding Configuration.ShowMilliseconds}"
                                  Margin="0,6" />
                        <CheckBox Content="Remove justification from reports" 
                                  IsChecked="{Binding Configuration.RemoveJustification}"
                                  Margin="0,6" />
                        <CheckBox Content="Show cover if present" 
                                  IsChecked="{Binding Configuration.ShowCover}"
                                  Margin="0,6" />
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Appearance Expander -->
            <Expander IsExpanded="True" Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="Appearance" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Padding="8,12" />
                </Expander.Header>
                <Border Padding="16,8,16,16" >
                    <StackPanel>
                        <!-- Theme -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="202" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Theme" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            <ComboBox Grid.Column="1"
                                      SelectedItem="{Binding Configuration.AppTheme}"
                                      HorizontalAlignment="Stretch"
                                          Height="36"
                                          Margin="0,0,0,0"
                                      Padding="12,8">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="{x:Type models:AppTheme}">
                                        <models:AppTheme>Auto</models:AppTheme>
                                        <models:AppTheme>Light</models:AppTheme>
                                        <models:AppTheme>Dark</models:AppTheme>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>
                        </Grid>

                        <!-- Report Font -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                       Text="Report font" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0" />
                            
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <ComboBox Grid.Column="0"     
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemTemplate="{StaticResource FontTemplate}" 
                                          Margin="0,0,8,0"
                                          Padding="12,8"
                                          Height="36"
                                          SelectedValuePath="Source"
                                          SelectedValue="{Binding Configuration.ReportFontFamily}"
                                          ItemsSource="{Binding Source={StaticResource FontFamilies}}" />
                                <ComboBox Grid.Column="1" 
                                          SelectedItem="{Binding Configuration.ReportFontSize}" 
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Padding="12,8"
                                          Height="36"
                                          Margin="0,0,8,0">
                                    <ComboBox.ItemsSource>
                                        <x:Array Type="{x:Type System:Double}">
                                            <System:Double>10</System:Double>
                                            <System:Double>11</System:Double>
                                            <System:Double>12</System:Double>
                                            <System:Double>14</System:Double>
                                            <System:Double>16</System:Double>
                                            <System:Double>18</System:Double>
                                            <System:Double>21</System:Double>
                                            <System:Double>24</System:Double>
                                            <System:Double>27</System:Double>
                                        </x:Array>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                                <CheckBox Grid.Column="2" 
                                          Content="Bold" 
                                          IsChecked="{Binding Configuration.ReportBoldStyle}"
                                          FontWeight="Bold"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <CheckBox Grid.Column="3" 
                                          Content="Italic" 
                                          IsChecked="{Binding Configuration.ReportItalicStyle}"
                                          FontStyle="Italic"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Context Menu Expander -->
            <Expander IsExpanded="False" Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="Windows Explorer Integration" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Padding="8,12" />
                </Expander.Header>
                <Border Padding="16,8,16,16" >
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            Add SharpMediaInfo to Windows Explorer context menu. Right-click any file and select "Analyze with SharpMediaInfo".
                            <LineBreak/>
                            <LineBreak/>
                            <Run FontWeight="SemiBold">Note:</Run> Installs for current user only (no administrator privileges required).
                            <LineBreak/>
                            On Windows 11, look for it under "Show more options".
                        </TextBlock>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Install Context Menu"
                                    Command="{Binding InstallContextMenuCommand}"
                                    IsEnabled="{Binding IsCheckingContextMenu, Converter={StaticResource InvertBooleanConverter}}"
                                    MinWidth="150"
                                    Padding="12,8"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Uninstall Context Menu"
                                    Command="{Binding UninstallContextMenuCommand}"
                                    IsEnabled="{Binding IsCheckingContextMenu, Converter={StaticResource InvertBooleanConverter}}"
                                    MinWidth="150"
                                    Padding="12,8"
                                    Margin="0,0,16,0" />
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           TextWrapping="Wrap">
                                    <Run Text="Status: " />
                                    <Run Text="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Installed|Not installed'}"
                                         FontWeight="SemiBold"
                                         Foreground="{Binding IsContextMenuInstalled, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green|Gray'}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- Recent Files History Expander -->
            <Expander IsExpanded="False" Margin="0,0,0,2">
                <Expander.Header>
                    <TextBlock Text="Recent files history" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Padding="8,12" />
                </Expander.Header>
                <Border Padding="16,8,16,16" >
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="History size"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <ctx:NumericUpDown x:Name="HistorySize"
                                           Grid.Column="1"
                                           Width="200"
                                           MaxValue="20"
                                           MinValue="0"
                                           ShowButtons="True"
                                           Value="{Binding Configuration.MaxRecentFiles, Mode=TwoWay}"
                                           Margin="0,0,16,0" />
                        <Button x:Name="ClearRecentFileList"
                                Grid.Column="2"
                                Content="Clear history"
                                MinWidth="110"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                Command="{Binding DataContext.ClearRecentFilesCommand, RelativeSource={RelativeSource AncestorType=TabControl}}" />
                    </Grid>
                </Border>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>