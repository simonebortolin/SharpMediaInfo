<UserControl 
    x:Class="SharpMediaInfo.GUI.WPF.Controls.NumericUpDown" 
    x:Name="ucNumericUpDown"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ctx="clr-namespace:SharpMediaInfo.GUI.WPF.Controls.Converters"
    mc:Ignorable="d"
    MinHeight="28"
    Width="130"
    Loaded="UcNumericUpDown_Loaded">
    <UserControl.Resources>
        <ctx:DecimationConverter x:Key="DecimationConverter" />
        <ctx:ButtonVisibilityConverter x:Key="BtnShowConverter" />

        <!-- Embedded button style for contrast and hover -->
        <Style x:Key="EmbeddedButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Integrated TextBox template based on Fluent TextBox control template, with embedded up/down buttons -->
        <Style x:Key="EmbeddedButtonsTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2,6,2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ContentBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        SnapsToDevicePixels="True">
                                    <Grid Margin="{TemplateBinding BorderThickness}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Text content host -->
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Grid.Column="0"
                                                      Padding="{TemplateBinding Padding}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      VerticalAlignment="Center"
                                                      SnapsToDevicePixels="True" />

                                        <!-- Right column for embedded buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,4,0"
                                                    Visibility="{Binding Path=ShowButtons, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BtnShowConverter}}">
                                            <Button x:Name="PART_UpButton" Style="{StaticResource EmbeddedButtonStyle}" Width="22" Height="14" Margin="0,0,0,2" Click="ButtonUp_Click" ToolTip="Increase"
                                                    Background="Transparent" BorderThickness="0">
                                                <Path Data="M18.78 15.78a.749.749 0 0 1-1.06 0L12 10.061 6.28 15.78a.749.749 0 1 1-1.06-1.06l6.25-6.25a.749.749 0 0 1 1.06 0l6.25 6.25a.749.749 0 0 1 0 1.06Z" 
                                                      Fill="{TemplateBinding Foreground}" 
                                                      Stretch="Uniform"
                                                      Width="8" Height="8" />
                                            </Button>
                                            <Button x:Name="PART_DownButton" Style="{StaticResource EmbeddedButtonStyle}" Width="22" Height="14" Click="ButtonDown_Click" ToolTip="Decrease" Background="Transparent" BorderThickness="0">
                                                <Path Data="M5.22 8.22a.749.749 0 0 0 0 1.06l6.25 6.25a.749.749 0 0 0 1.06 0l6.25-6.25a.749.749 0 1 0-1.06-1.06L12 13.939 6.28 8.22a.749.749 0 0 0-1.06 0Z" 
                                                      Fill="{TemplateBinding Foreground}" 
                                                      Stretch="Uniform"
                                                      Width="8" Height="8" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundPointerOver}" />
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushPointerOver}" />
                                <Setter TargetName="PART_ContentHost" Property="Foreground" Value="{DynamicResource TextControlForegroundPointerOver}" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundFocused}" />
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushFocused}" />
                                <Setter TargetName="PART_ContentHost" Property="Foreground" Value="{DynamicResource TextControlForegroundFocused}" />
                                <Setter TargetName="ContentBorder" Property="Margin" Value="-1,-1,-1,-1" />
                                <Setter TargetName="ContentBorder" Property="BorderThickness" Value="1,1,1,2" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ContentBorder" Property="Background" Value="{DynamicResource TextControlBackgroundDisabled}" />
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource TextControlBorderBrushDisabled}" />
                                <Setter TargetName="PART_ContentHost" Property="Foreground" Value="{DynamicResource TextControlForegroundDisabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- Use TextBox with embedded buttons template -->
        <TextBox x:Name="tbValue"
                 Style="{StaticResource EmbeddedButtonsTextBox}"
                 Grid.Column="0"
                 Padding="6,4,6,4"
                 VerticalContentAlignment="Center"
                 HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>