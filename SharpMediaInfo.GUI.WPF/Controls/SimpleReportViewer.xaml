<UserControl x:Class="SharpMediaInfo.GUI.WPF.Controls.SimpleReportViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SharpMediaInfo.GUI.WPF.Controls"
             xmlns:converters="clr-namespace:SharpMediaInfo.GUI.WPF.Converters"
             x:Name="SimpleReportViewerControl">
    <UserControl.Resources>
        <local:IndentToMarginConverter x:Key="IndentConverter"/>
        <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Cover Image -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="10,10,5,10"
                Padding="8"
                Visibility="{Binding HasCover, Converter={StaticResource BoolToVisConverter}, ElementName=SimpleReportViewerControl}">
            <Image Source="{Binding CoverData, Converter={StaticResource ByteArrayToImageConverter}, ElementName=SimpleReportViewerControl}"
                   Width="155"
                   Stretch="Uniform"
                   StretchDirection="DownOnly"
                   Tag="{Binding SaveCoverCommand, ElementName=SimpleReportViewerControl}">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Save Cover..." 
                                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Border>
        
        <!-- Report Sections -->
        <ScrollViewer Grid.Column="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SectionsContainer" Padding="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <GroupBox Header="{Binding Title}" 
                                  Margin="0,5,0,5"
                                  Padding="10">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               FontWeight="Bold" 
                                               FontSize="13"/>
                                </DataTemplate>
                            </GroupBox.HeaderTemplate>
                            
                            <!-- Section Items -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Margin">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource IndentConverter}">
                                                                <Binding Path="IndentLevel"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Label part -->
                                                <TextBlock FontFamily="{Binding Configuration.ReportFontFamily, ElementName=SimpleReportViewerControl}" 
                                                           FontSize="{Binding Configuration.ReportFontSize, ElementName=SimpleReportViewerControl}"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <!-- Header style -->
                                                                <DataTrigger Binding="{Binding Type}" Value="0">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="FontSize" Value="13"/>
                                                                </DataTrigger>
                                                                <!-- Subheader style -->
                                                                <DataTrigger Binding="{Binding Type}" Value="1">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="FontSize" Value="11.5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Configuration.ReportBoldStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Configuration.ReportItalicStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                                </TextBlock>
                                                <!-- Colon part (only if Label is not empty) -->
                                                <TextBlock FontFamily="{Binding Configuration.ReportFontFamily, ElementName=SimpleReportViewerControl}" 
                                                           FontSize="{Binding Configuration.ReportFontSize, ElementName=SimpleReportViewerControl}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Label}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Configuration.ReportBoldStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Configuration.ReportItalicStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text=": "></Run>
                                                </TextBlock>
                                                <!-- Value part -->
                                                <TextBlock FontFamily="{Binding Configuration.ReportFontFamily, ElementName=SimpleReportViewerControl}" 
                                                           FontSize="{Binding Configuration.ReportFontSize, ElementName=SimpleReportViewerControl}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Configuration.ReportBoldStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Configuration.ReportItalicStyle, ElementName=SimpleReportViewerControl}" Value="True">
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
