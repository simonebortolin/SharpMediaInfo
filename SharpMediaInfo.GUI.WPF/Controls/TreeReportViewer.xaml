<UserControl x:Class="SharpMediaInfo.GUI.WPF.Controls.TreeReportViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SharpMediaInfo.GUI.WPF.Controls"
             x:Name="TreeReportViewerControl">
    <TreeView ItemsSource="{Binding Nodes, ElementName=TreeReportViewerControl}"
              FontFamily="{Binding Configuration.ReportFontFamily, ElementName=TreeReportViewerControl}" 
              FontSize="{Binding Configuration.ReportFontSize, ElementName=TreeReportViewerControl}">
        <TreeView.Style>
            <Style TargetType="TreeView">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Configuration.ReportBoldStyle, ElementName=TreeReportViewerControl}" Value="True">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Configuration.ReportItalicStyle, ElementName=TreeReportViewerControl}" Value="True">
                        <Setter Property="FontStyle" Value="Italic"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TreeView.Style>
        <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Style.Triggers>
                    <!-- Section style (bold) -->
                    <DataTrigger Binding="{Binding Type}" Value="1">
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                    <!-- Track style (semi-bold) -->
                    <DataTrigger Binding="{Binding Type}" Value="2">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Header}"/>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Value}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Value}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text=": "/>
                        <Run Text="{Binding Value, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>
